{
  "name": "cx-amazon-sp-api",
  "version": "0.1.6",
  "description": "Reads and updates your own Amazon store.",
  "license": "MIT",
  "author": "ComChatX",
  "homepage": "https://github.com/comchatx/cx-amazon-sp-api#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/comchatx/cx-amazon-sp-api.git"
  },
  "bugs": "https://github.com/comchatx/cx-amazon-sp-api/issues",
  "keywords": [
    "pi-package"
  ],
  "type": "module",
  "pi": {
    "skills": [
      "./skills"
    ],
    "prompts": [
      "./prompts"
    ]
  },
  "files": [
    "skills",
    "prompts",
    "README.zh-CN.md"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "comchatx": {
    "name": "Amazon SP-API",
    "description": {
      "zh": "读取并更新你自己的亚马逊店铺。"
    },
    "mark": {
      "line": "layout"
    },
    "section": "data",
    "order": 20,
    "skills": {
      "amazon-sp-api": {
        "zh": "通过 SP-API 读取和修改你自己的亚马逊店铺：订单、Listing、库存、报告、Feed 和财务数据，覆盖你授权的每个区域。"
      }
    },
    "prompts": {
      "orders-today": {
        "zh": "按站点查看店铺今天的订单"
      },
      "low-stock": {
        "zh": "找出两周内会断货的 FBA Listing"
      },
      "listing-check": {
        "zh": "检查 Listing 上亚马逊标出的问题，并给出修复方案"
      }
    },
    "source": {
      "name": "amazon-sp-api",
      "help": "https://developer-docs.amazon/sp-api/docs/self-authorization",
      "aspects": {}
    }
  },
  "dependencies": {
    "cx-sources": "^0.1.3"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "1.4.0",
    "@types/node": "26.2.0",
    "typescript": "7.0.2",
    "vitest": "4.1.11"
  }
}
