    "section": "data",
    "order": 20,
    "skills": {
      "amazon-sp-api": {
        "zh": "读取和修改你的亚马逊店铺：订单、listing、库存和财务。",
        "en": "Reads and changes your Amazon store: orders, listings, stock and finances."
      }
    },
    "prompts": {
      "orders-today": {
        "zh": "按站点查看店铺今天的订单"
      },
      "low-stock": {
        "zh": "找出两周内会断货的 FBA listing"
      },
      "listing-check": {
        "zh": "检查【SKU】这条 listing 上亚马逊标出的问题，并给出修复方案"
      }
    },
    "builds": [
      {
        "on": "cx-amazon-seller",
        "need": "optional",
        "why": {
          "en": "Tells cx from the start that you sell on Amazon.",
          "zh": "用于让 cx 从第一条消息起就知道你在亚马逊开店。"
        }
      }
    ],
    "source": {
      "name": "amazon-sp-api",
      "help": "https://developer-docs.amazon/sp-api/docs/self-authorization",
      "aspects": {},
      "fields": {
        "client_id": {
          "label": {
            "en": "Client identifier",
            "zh": "Client identifier"
          }
        },
        "client_secret": {
          "label": {
            "en": "Client secret",
            "zh": "Client secret"
          }
        },
        "refresh_token": {
          "label": {
            "en": "Refresh token",
            "zh": "Refresh token"
          }
        }
      },
      "lines": {
        "add": {
          "en": "Add a store",
          "zh": "添加店铺"
        },
        "removedWith": {
          "en": "Its stores {names} are removed with it.",
          "zh": "它的店铺 {names} 会一并移除。"
        },
        "connect": {
          "en": "Connect your store",
          "zh": "连接店铺"
        },
        "canChange": {
          "en": "Once connected, cx can read and change your store.",
          "zh": "连接后，cx 可以读取和修改你的店铺。"
        },
        "rows": {
          "en": "Stores",
          "zh": "店铺"
        },
        "checking": {
          "en": "Checking with Amazon…",
          "zh": "正在向亚马逊确认…"
        },
        "sells": {
          "en": "Sells in {places}",
          "zh": "在{places}销售"
        },
        "foundNone": {
          "en": "Amazon found no store for this token; get a new one with the Amazon account you sell with.",
          "zh": "亚马逊没有找到店铺，请用开店的亚马逊账号获取新的 Refresh token。"
        },
        "connected": {
          "en": "Store connected.",
          "zh": "店铺已连接。"
        },
        "refused": {
          "en": "Amazon no longer accepts this refresh token. Add a new one, then remove this one.",
          "zh": "亚马逊已不接受这个 Refresh token，请添加新的，再移除这一行。"
        },
        "none": {
          "en": "Amazon listed no marketplace for this store.",
          "zh": "亚马逊没有列出这家店铺的站点。"
        }
      },
      "regions": {
        "na": {
          "en": "North America",
          "zh": "北美"
        },
        "eu": {
          "en": "Europe",
          "zh": "欧洲"
        },
        "fe": {
          "en": "Far East",
          "zh": "远东"
        }
      }
    }
